# Copy to .env (chmod 600) next to this file. Loaded by the systemd unit via
# EnvironmentFile; `make debug` / `make run` source it too. Never commit .env.
QLCPLUS_HOST=qlc-server.local          # host running the QLC+ daemon (WebSocket :9999)
QLCPLUS_WS_PORT=9999
HA_BASE_URL=http://localhost:8123      # Home Assistant, if you use the HA actions
HA_TOKEN=                              # HA long-lived access token (Profile → Security)
HA_DISCO_ENTITY=switch.disco_ball      # entity toggled by the disco-ball key
